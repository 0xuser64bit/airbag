# Copy to .env (gitignored) and fill in. Never commit real values.
# Engine and scripts load it with `node --env-file-if-exists=.env`.

# ---- Engine (apps/engine) -------------------------------------------------------------------

# testnet | mainnet. Everything else network-specific comes from GET /api/v1/pub/context.
PERPL_NETWORK=testnet
# live | simulation. Simulation runs the same engine on a paper exchange with scripted prices.
ENGINE_MODE=simulation

# 32 random bytes, base64: openssl rand -base64 32. Required in live mode. Keep it in the host's
# secret store; losing it means every linked key must be linked again.
MASTER_KEY=
# MASTER_KEY_VERSION=1
# During a rotation, the previous key too: MASTER_KEY_1=... (docs/SECURITY.md)

# Browser origins allowed to call the API (comma-separated). The first is the SIWE domain.
WEB_ORIGIN=http://localhost:3000
# The engine's static egress IPs, shown on the link-key page for the key's IP allow-list.
ENGINE_EGRESS_IPS=
PORT=8787
DATABASE_PATH=./data/airbag.db
# Behind a proxy, the header with the client IP (for rate limits), e.g. fly-client-ip.
# CLIENT_IP_HEADER=

# Protection. Defaults shown.
# MARKETS=BTC,ETH
# STALE_BLOCKS=3
# SLIPPAGE_BPS=50
# MAX_DEPLOY_ATTEMPTS=3
# Wallets allowed demo mode (deploy after a 0.3% move), comma-separated.
# DEMO_WALLETS=

# Web Push (npx web-push generate-vapid-keys). Push is off without them.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# AirbagLog writer (contracts/README.md). The onchain log is off without them.
# AIRBAG_LOG_ADDRESS=
# AIRBAG_LOG_PRIVATE_KEY=

# Optional URL overrides (defaults per network are in packages/perpl/src/networks.ts)
# PERPL_API_URL=https://testnet.perpl.xyz/api
# PERPL_WS_URL=wss://testnet.perpl.xyz
# MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# MONAD_WS_URL=wss://testnet-rpc.monad.xyz
# LOG_LEVEL=info

# ---- Web (apps/web) -------------------------------------------------------------------------

NEXT_PUBLIC_ENGINE_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SOURCE_URL=https://github.com/0xuser64bit/airbag
# The engine as the web server reaches it, if different from NEXT_PUBLIC_ENGINE_URL.
# ENGINE_URL=
# Envio GraphQL endpoint (indexer/) for the landing page's liquidation count. Hidden without it.
# INDEXER_URL=

# ---- M0 spike only --------------------------------------------------------------------------

# A Trade-scoped key you created at https://testnet.perpl.xyz/apikeys.
# PERPL_API_KEY is the X-API-Key token; PERPL_API_SECRET is the 32-byte Ed25519 private key as hex.
PERPL_API_KEY=
PERPL_API_SECRET=
