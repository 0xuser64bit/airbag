# Copy to .env (gitignored) and fill in. Never commit real values.
# Scripts load it with `node --env-file-if-exists=.env`.

# testnet | mainnet. Everything else network-specific comes from GET /api/v1/pub/context.
PERPL_NETWORK=testnet

# Optional overrides (defaults per network are in packages/perpl/src/networks.ts)
# PERPL_API_URL=https://testnet.perpl.xyz/api
# PERPL_WS_URL=wss://testnet.perpl.xyz
# MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# M0 spike only: a Trade-scoped key you created at https://testnet.perpl.xyz/apikeys
# PERPL_API_KEY is the X-API-Key token; PERPL_API_SECRET is the 32-byte Ed25519 private key as hex.
PERPL_API_KEY=
PERPL_API_SECRET=
