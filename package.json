{
  "name": "airbag",
  "private": true,
  "description": "Liquidation protection for Perpl traders on Monad",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p . && tsc -p apps/web && tsc -p e2e",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "build": "pnpm --filter @airbag/web build",
    "e2e": "playwright test",
    "contracts:test": "docker run --rm -v \"$PWD/contracts:/app\" -w /app --user root --entrypoint forge ghcr.io/foundry-rs/foundry@sha256:043752653d5be351c71709091b3db97c4421c907eb40ea294195e7f532aadf46 test -vv",
    "contracts:build": "docker run --rm -v \"$PWD/contracts:/app\" -w /app --user root --entrypoint forge ghcr.io/foundry-rs/foundry@sha256:043752653d5be351c71709091b3db97c4421c907eb40ea294195e7f532aadf46 build",
    "dev:engine": "ENGINE_MODE=${ENGINE_MODE:-simulation} node --env-file-if-exists=.env --watch apps/engine/src/main.ts",
    "dev:web": "pnpm --filter @airbag/web dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "viem": "2.56.8",
    "vitest": "^5.0.1"
  }
}
